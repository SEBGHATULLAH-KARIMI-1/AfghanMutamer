# رشته‌ی اتصال Neon (Dashboard → Connection string). حتماً با ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# حداقل ۳۲ کاراکتر تصادفی:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# آدرس فرانت روی Netlify (چند آدرس با کاما). بدون / در انتها
CORS_ORIGIN=http://localhost:5173
# فقط برای ساخت اولین کاربر مدیر (اگر خالی بماند، یک رمز تصادفی ساخته و در لاگ چاپ می‌شود)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PORT=4000

# دستیار هوش مصنوعی (اختیاری). کلید از console.anthropic.com — این کلید فقط روی سرور می‌ماند
# اگر خالی بماند، دستیار فقط از موتور محلی استفاده می‌کند
ANTHROPIC_API_KEY=
# مدل (پیش‌فرض: claude-sonnet-5-5؛ ارزان‌تر و سریع‌تر: claude-haiku-5-5)
AI_MODEL=

# گزینه‌ی رایگان: هر سرویس سازگار با OpenAI (مثلاً Groq: console.groq.com). اگر ANTHROPIC_API_KEY خالی باشد از این استفاده می‌شود
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
